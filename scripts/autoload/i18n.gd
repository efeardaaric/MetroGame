func set_language(l: String) -> void:
	lang = "tr" if l == "tr" else "en"
	language_changed.emit()


func t(key: String) -> String:
	if not STRINGS.has(key):
		return key
	var v = STRINGS[key]
	return v[0] if lang == "tr" else v[1]


func month_name(m: int) -> String:
	var arr: Array = STRINGS["months"][0 if lang == "tr" else 1]
	return arr[clampi(m, 0, 11)]
