# Metro Tycoon: Türkiye — App Store automation.
#
#   bundle exec fastlane ios metadata     # upload texts + screenshots (no binary)
#   bundle exec fastlane ios beta         # build + upload to TestFlight
#   bundle exec fastlane ios release      # build + upload + submit for review
#
# Auth: App Store Connect API key via env (recommended):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to AuthKey_XXXX.p8)
# Team: FASTLANE_TEAM_ID (10 characters, developer.apple.com → Membership).

default_platform(:ios)

platform :ios do
  def asc_key
    return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
                              key_filepath: ENV["ASC_KEY_PATH"])
  end

  desc "Copy the framed store screenshots into fastlane's layout"
  lane :screenshots_sync do
    { "tr" => "tr", "en-US" => "en" }.each do |locale, src|
      dir = File.expand_path("screenshots/#{locale}", __dir__)
      FileUtils.rm_rf(dir)
      FileUtils.mkdir_p(dir)
      %w[1290x2796 2048x2732].each do |size|
        Dir[File.expand_path("../docs/store/#{size}/#{src}/*.jpg", __dir__)].sort.each do |f|
          FileUtils.cp(f, File.join(dir, "#{size}_#{File.basename(f)}"))
        end
      end
    end
  end

  desc "Upload App Store texts and screenshots"
  lane :metadata do
    screenshots_sync
    deliver(api_key: asc_key, skip_binary_upload: true, overwrite_screenshots: true,
            force: true, run_precheck_before_submit: false, submit_for_review: false)
  end

  desc "Build with Godot + Xcode and upload to TestFlight"
  lane :beta do
    team = ENV["FASTLANE_TEAM_ID"] || UI.user_error!("Set FASTLANE_TEAM_ID")
    build = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    sh("cd .. && ./tools/ios_release_mac.sh #{team} #{build}")
  end

  desc "Submit the latest processed TestFlight build (run `beta` first and wait for processing)"
  lane :release do
    screenshots_sync
    deliver(api_key: asc_key, skip_binary_upload: true, overwrite_screenshots: true, force: true,
            build_number: ENV["BUILD_NUMBER"], submit_for_review: true, automatic_release: false,
            run_precheck_before_submit: false,
            submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false })
  end
end
